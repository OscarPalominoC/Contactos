# Copie este archivo como .env y complete los valores. Nunca versione el .env real.
ENVIRONMENT=local
DEBUG=True
SECRET_KEY=<cadena-aleatoria-de-50-caracteres>
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://check_app:<clave>@localhost:5433/check_contactos
JWT_PRIVATE_KEY_PATH=keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=keys/jwt_public.pem
JWT_ISSUER=check-contactos
JWT_AUDIENCE=check-contactos-web
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Ruta del Django Admin: nunca /admin/. Ejemplo: gestion-<4 bytes en hex>/
ADMIN_URL=gestion-<aleatorio>/
# Contraseña temporal predeterminada al inicializar o reiniciar cuentas
CLAVE_TEMPORAL_INICIAL=CheckLTDA!
# Días de duración de la sesión (se renueva con cada uso)
SESION_DIAS=30
